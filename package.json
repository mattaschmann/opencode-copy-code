{
  "name": "opencode-copy-code",
  "version": "0.0.0",
  "description": "OpenCode TUI plugin that draws fenced code blocks in a box and copies code blocks from the latest reply.",
  "author": "Matt Aschmann <matt.aschmann@gmail.com>",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "format": "prettier --write 'src/**/*.ts' 'test/**/*.ts'"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mattaschmann/opencode-copy-code.git"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.5"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.14",
    "@opentui/solid": ">=0.5.14",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opentui/core": "0.8.2",
    "@opentui/solid": "0.8.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "bun-types": "^1.3.6",
    "jest": "^30.3.0",
    "prettier": "^3.4.2",
    "solid-js": "1.9.17",
    "ts-jest": "^29.4.9",
    "typescript": "^5.9.3"
  },
  "files": [
    "src",
    "package.json",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@opentui/solid": {
      "solid-js": "$solid-js"
    },
    "glob": "^14.0.3",
    "minimatch": "^11.0.4"
  }
}
